 804:ReactivePedal.cpp **** void chorusSampler(AudioHandle::InputBuffer in, AudioHandle::OutputBuffer out , size_t size ){
 805:ReactivePedal.cpp ****     for(size_t i = 0; i < size; i++){
 806:ReactivePedal.cpp ****         float x = useGeneratedSignal ? GenerateSignal() : in[0][i];
 807:ReactivePedal.cpp ****         float y = x;
 808:ReactivePedal.cpp **** 
 809:ReactivePedal.cpp ****         extractor.PushSample(x);
 810:ReactivePedal.cpp **** 
 811:ReactivePedal.cpp ****         if(currEffectMode == MODE_DISTORTION){
 812:ReactivePedal.cpp ****             y = ProcessTone(x);
 813:ReactivePedal.cpp ****         }
 814:ReactivePedal.cpp ****         else if(currEffectMode == MODE_CHORUS){
 815:ReactivePedal.cpp ****             float delay = baseDelay + depth * sinf(phase);
 816:ReactivePedal.cpp ****             float delayed = ReadDelay(delay);
 817:ReactivePedal.cpp ****             y = ((1.0f - chorusMix) * x + chorusMix * delayed) * 1.5f;
 818:ReactivePedal.cpp ****             delayBuffer[writeIndex] = x;
 819:ReactivePedal.cpp ****             writeIndex = (writeIndex + 1) % bufferSize;
 820:ReactivePedal.cpp ****             phase += phaseIncrement;
 821:ReactivePedal.cpp ****             if(phase >= 6.28318530718f) phase -= 6.28318530718f;
 822:ReactivePedal.cpp ****         }
 823:ReactivePedal.cpp ****         else if(currEffectMode == MODE_AMBIENT){
 824:ReactivePedal.cpp ****             y = ambientProcessor(x);
 825:ReactivePedal.cpp ****         }
