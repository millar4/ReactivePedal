 487:ReactivePedal.cpp **** bool ComputeDatasetNormalisation(){
 488:ReactivePedal.cpp ****     for(int i = 0; i < 12; i++){
 489:ReactivePedal.cpp ****         datasetMean[i] = 0.0f;
 490:ReactivePedal.cpp ****         datasetStd[i] = 1.0f;
