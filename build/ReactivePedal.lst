 512:ReactivePedal.cpp ****         datasetMean[j] *= inv;
 513:ReactivePedal.cpp ****     }
 514:ReactivePedal.cpp **** 
 515:ReactivePedal.cpp ****     for(int classId = 0; classId < 4; classId++){
 516:ReactivePedal.cpp ****         for(int i = 0; i < bufferCount[classId]; i++){
