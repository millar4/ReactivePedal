 265:ReactivePedal.cpp **** void FinalisePhrase(AudioFeatures& out){
 266:ReactivePedal.cpp ****     std::memset(&out, 0, sizeof(AudioFeatures));
 267:ReactivePedal.cpp ****     if(phraseFrames <= 0){
 268:ReactivePedal.cpp ****         return;
 269:ReactivePedal.cpp ****     }
 270:ReactivePedal.cpp **** 
 271:ReactivePedal.cpp ****     float inv = 1.0f / (float)phraseFrames;
 272:ReactivePedal.cpp ****     out.rms = phraseAccum.rms * inv;
 273:ReactivePedal.cpp ****     out.peak = phraseMaxPeak;
 274:ReactivePedal.cpp ****     out.zcr = phraseAccum.zcr * inv;
 275:ReactivePedal.cpp ****     out.spectralCentroid = phraseAccum.spectralCentroid * inv;
 276:ReactivePedal.cpp ****     out.spectralFlux = phraseAccum.spectralFlux * inv;
 277:ReactivePedal.cpp ****     out.envelope = phraseAccum.envelope * inv;
 278:ReactivePedal.cpp ****     out.rmsVariance = phraseMaxRms - phraseMinRms;
 279:ReactivePedal.cpp ****     out.centroidVariance = phraseMaxCentroid - phraseMinCentroid;
 280:ReactivePedal.cpp **** 
 281:ReactivePedal.cpp ****     uint32_t phraseEndMs = lastActiveMs;
 282:ReactivePedal.cpp ****     if(phraseEndMs < phraseStartMs){
 283:ReactivePedal.cpp ****         phraseEndMs = phraseStartMs;
 284:ReactivePedal.cpp ****     }
 285:ReactivePedal.cpp **** 
 286:ReactivePedal.cpp ****     float phraseDurationSec = (float)(phraseEndMs - phraseStartMs) / 1000.0f;
 287:ReactivePedal.cpp ****     if(phraseDurationSec < 0.001f){
 288:ReactivePedal.cpp ****         phraseDurationSec = 0.001f;
 289:ReactivePedal.cpp ****     }
 290:ReactivePedal.cpp **** 
 291:ReactivePedal.cpp ****     float attacksPerSecond = (float)phraseAttackCount / phraseDurationSec;
 292:ReactivePedal.cpp **** 
 293:ReactivePedal.cpp ****     uint32_t gapFromLastAttackMs = 0;
 294:ReactivePedal.cpp ****     if(lastPhraseAttackMs > 0 && phraseEndMs >= lastPhraseAttackMs){
 295:ReactivePedal.cpp ****         gapFromLastAttackMs = phraseEndMs - lastPhraseAttackMs;
ARM GAS  /var/folders/6_/psd2b8g56p7696hhrr4ztjs00000gn/T//ccBmiAjS.s 			page 27


 296:ReactivePedal.cpp ****     }
 297:ReactivePedal.cpp ****     else{
 298:ReactivePedal.cpp ****         gapFromLastAttackMs = phraseEndMs - phraseStartMs;
 299:ReactivePedal.cpp ****     }
 300:ReactivePedal.cpp **** 
 301:ReactivePedal.cpp ****     float tailGapSec = (float)gapFromLastAttackMs / 1000.0f;
 302:ReactivePedal.cpp ****     float sustainRatio = tailGapSec / phraseDurationSec;
 303:ReactivePedal.cpp ****     if(sustainRatio > 1.0f){
 304:ReactivePedal.cpp ****         sustainRatio = 1.0f;
 305:ReactivePedal.cpp ****     }
 306:ReactivePedal.cpp **** 
 307:ReactivePedal.cpp ****     out.onsetCount = (float)phraseAttackCount;
 308:ReactivePedal.cpp ****     out.rmsDelta = attacksPerSecond;
 309:ReactivePedal.cpp ****     out.envelopeDelta = sustainRatio;
 310:ReactivePedal.cpp ****     out.timeSinceLastOnset = tailGapSec;
 311:ReactivePedal.cpp **** }
