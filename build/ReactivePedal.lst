 255:ReactivePedal.cpp ****     out.envelopeDelta      = 0.25f * out.envelopeDelta + 0.75f * in.envelopeDelta;
 256:ReactivePedal.cpp ****     out.rmsVariance        = 0.45f * out.rmsVariance + 0.55f * in.rmsVariance;
 257:ReactivePedal.cpp ****     out.centroidVariance   = 0.45f * out.centroidVariance + 0.55f * in.centroidVariance;
 258:ReactivePedal.cpp ****     out.onsetCount         = 0.15f * out.onsetCount + 0.85f * in.onsetCount;
 259:ReactivePedal.cpp ****     out.timeSinceLastOnset = 0.15f * out.timeSinceLastOnset + 0.85f * in.timeSinceLastOnset;
 260:ReactivePedal.cpp **** }
