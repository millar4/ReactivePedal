 413:ReactivePedal.cpp ****         out.envelopeDelta += f.envelopeDelta;
 414:ReactivePedal.cpp ****         out.rmsVariance += f.rmsVariance;
 415:ReactivePedal.cpp ****         out.centroidVariance += f.centroidVariance;
 416:ReactivePedal.cpp ****         out.onsetCount += f.onsetCount;
