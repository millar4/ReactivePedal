 374:ReactivePedal.cpp **** //is the current frame active enough
 375:ReactivePedal.cpp **** bool IsPhraseSignalActive(const AudioFeatures& f){
 376:ReactivePedal.cpp ****     return
 377:ReactivePedal.cpp ****         f.rms > 0.0030f ||
 378:ReactivePedal.cpp ****         f.peak > 0.0060f ||
 379:ReactivePedal.cpp ****         f.envelope > 0.0030f;
 380:ReactivePedal.cpp **** }
