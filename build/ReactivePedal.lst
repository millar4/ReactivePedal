 224:ReactivePedal.cpp **** //inbound raw, smoothed out 
 225:ReactivePedal.cpp **** void SmoothFeatures(const AudioFeatures& in, AudioFeatures& out){
 226:ReactivePedal.cpp ****     out.rms                = 0.35f * out.rms + 0.65f * in.rms; //exponential smoothing 
 227:ReactivePedal.cpp ****     out.peak               = 0.35f * out.peak + 0.65f * in.peak;
 228:ReactivePedal.cpp ****     out.zcr                = 0.45f * out.zcr + 0.55f * in.zcr;
 229:ReactivePedal.cpp ****     out.spectralCentroid   = 0.45f * out.spectralCentroid + 0.55f * in.spectralCentroid;
 230:ReactivePedal.cpp ****     out.spectralFlux       = 0.30f * out.spectralFlux + 0.70f * in.spectralFlux;
 231:ReactivePedal.cpp ****     out.rmsDelta           = 0.25f * out.rmsDelta + 0.75f * in.rmsDelta;
 232:ReactivePedal.cpp ****     out.envelope           = 0.35f * out.envelope + 0.65f * in.envelope;
 233:ReactivePedal.cpp ****     out.envelopeDelta      = 0.25f * out.envelopeDelta + 0.75f * in.envelopeDelta;
 234:ReactivePedal.cpp ****     out.rmsVariance        = 0.45f * out.rmsVariance + 0.55f * in.rmsVariance;
 235:ReactivePedal.cpp ****     out.centroidVariance   = 0.45f * out.centroidVariance + 0.55f * in.centroidVariance;
 236:ReactivePedal.cpp ****     out.onsetCount         = 0.15f * out.onsetCount + 0.85f * in.onsetCount; //need heavy weights t
 237:ReactivePedal.cpp ****     out.timeSinceLastOnset = 0.15f * out.timeSinceLastOnset + 0.85f * in.timeSinceLastOnset;
 238:ReactivePedal.cpp **** }
