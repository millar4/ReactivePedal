 263:ReactivePedal.cpp **** 
 264:ReactivePedal.cpp **** //called for each frame during a phrase
 265:ReactivePedal.cpp **** void AccumulatePhrase(const AudioFeatures& f, uint32_t nowMs){
 266:ReactivePedal.cpp **** 
 267:ReactivePedal.cpp ****     //f is one frame in this function
 268:ReactivePedal.cpp ****     //Below is the accumulation section
 269:ReactivePedal.cpp ****     phraseAccum.rms += f.rms;
 270:ReactivePedal.cpp ****     phraseAccum.peak += f.peak;
 271:ReactivePedal.cpp ****     phraseAccum.zcr += f.zcr;
 272:ReactivePedal.cpp ****     phraseAccum.spectralCentroid += f.spectralCentroid;
 273:ReactivePedal.cpp ****     phraseAccum.spectralFlux += f.spectralFlux;
 274:ReactivePedal.cpp ****     phraseAccum.rmsDelta += f.rmsDelta;
 275:ReactivePedal.cpp ****     phraseAccum.envelope += f.envelope;
 276:ReactivePedal.cpp ****     phraseAccum.envelopeDelta += f.envelopeDelta;
 277:ReactivePedal.cpp ****     phraseAccum.rmsVariance += f.rmsVariance;
 278:ReactivePedal.cpp ****     phraseAccum.centroidVariance += f.centroidVariance;
 279:ReactivePedal.cpp ****     phraseAccum.onsetCount += f.onsetCount;
 280:ReactivePedal.cpp ****     phraseAccum.timeSinceLastOnset += f.timeSinceLastOnset;
 281:ReactivePedal.cpp ****     phraseFrames++;
 282:ReactivePedal.cpp **** 
 283:ReactivePedal.cpp ****     //extremity tracking
 284:ReactivePedal.cpp ****     //track highest RMS seen , lowest RMS seen, highest centroid, lowest centroid etc, this allows 
 285:ReactivePedal.cpp ****     if(f.rms > phraseMaxRms) phraseMaxRms = f.rms;
 286:ReactivePedal.cpp ****     if(f.rms < phraseMinRms) phraseMinRms = f.rms;
 287:ReactivePedal.cpp ****     if(f.spectralCentroid > phraseMaxCentroid) phraseMaxCentroid = f.spectralCentroid;
 288:ReactivePedal.cpp ****     if(f.spectralCentroid < phraseMinCentroid) phraseMinCentroid = f.spectralCentroid;
 289:ReactivePedal.cpp ****     if(f.peak > phraseMaxPeak) phraseMaxPeak = f.peak;
 290:ReactivePedal.cpp **** 
 291:ReactivePedal.cpp ****     //do we have a strong attack, strong amplitude, significant frequency spectrum changes from pre
 292:ReactivePedal.cpp ****     //alternatively we could have have strongly rising amplitude envelope or changes in harmonic co
 293:ReactivePedal.cpp ****     //overall this detects the start of a plucked note 
 294:ReactivePedal.cpp ****     bool strongAttack = f.peak > 0.0075f && (f.spectralFlux > 0.035f || f.envelopeDelta > 0.012f ||
 295:ReactivePedal.cpp **** 
ARM GAS  /var/folders/6_/psd2b8g56p7696hhrr4ztjs00000gn/T//ccL16ted.s 			page 27


 296:ReactivePedal.cpp ****     bool cooldownExpired =
 297:ReactivePedal.cpp ****         lastPhraseAttackMs == 0 ||
 298:ReactivePedal.cpp ****         (nowMs - lastPhraseAttackMs) > phraseAttackCooldownMs;
 299:ReactivePedal.cpp **** 
 300:ReactivePedal.cpp ****     if(strongAttack && cooldownExpired){
 301:ReactivePedal.cpp ****         if(phraseAttackCount == 0){
 302:ReactivePedal.cpp ****             firstPhraseAttackMs = nowMs;
 303:ReactivePedal.cpp ****         }
 304:ReactivePedal.cpp ****         else{
 305:ReactivePedal.cpp ****             //detect distance between attacks
 306:ReactivePedal.cpp ****             phraseAttackGapSumMs += (float)(nowMs - prevPhraseAttackMs);
 307:ReactivePedal.cpp ****             phraseAttackGapCount++;
 308:ReactivePedal.cpp ****         }
 309:ReactivePedal.cpp ****         
 310:ReactivePedal.cpp ****         phraseAttackCount++;
 311:ReactivePedal.cpp ****         prevPhraseAttackMs = nowMs;
 312:ReactivePedal.cpp ****         lastPhraseAttackMs = nowMs;
 313:ReactivePedal.cpp ****     }
 314:ReactivePedal.cpp **** }
 315:ReactivePedal.cpp **** 
 316:ReactivePedal.cpp **** //create audio features summary
 317:ReactivePedal.cpp **** void FinalisePhrase(AudioFeatures& out){
 318:ReactivePedal.cpp ****     //zero out the output 
 319:ReactivePedal.cpp ****     std::memset(&out, 0, sizeof(AudioFeatures));
 320:ReactivePedal.cpp ****     if(phraseFrames <= 0){
 321:ReactivePedal.cpp ****         return;
 322:ReactivePedal.cpp ****     }
 323:ReactivePedal.cpp **** 
 324:ReactivePedal.cpp ****     float inv = 1.0f / (float)phraseFrames;
 325:ReactivePedal.cpp **** 
 326:ReactivePedal.cpp ****     //average frame based values, not everything is the average though
 327:ReactivePedal.cpp **** 
 328:ReactivePedal.cpp ****     out.rms = phraseAccum.rms * inv; //mean RMS
 329:ReactivePedal.cpp ****     out.peak = phraseMaxPeak; //use maximum peak of the phrase
 330:ReactivePedal.cpp ****     out.zcr = phraseAccum.zcr * inv;
 331:ReactivePedal.cpp ****     out.spectralCentroid = phraseAccum.spectralCentroid * inv; //
 332:ReactivePedal.cpp ****     out.spectralFlux = phraseAccum.spectralFlux * inv;
 333:ReactivePedal.cpp ****     out.envelope = phraseAccum.envelope * inv;
 334:ReactivePedal.cpp ****     out.rmsVariance = phraseMaxRms - phraseMinRms; //phrase change over time
 335:ReactivePedal.cpp ****     out.centroidVariance = phraseMaxCentroid - phraseMinCentroid; //phrase change over time
 336:ReactivePedal.cpp **** 
 337:ReactivePedal.cpp **** 
 338:ReactivePedal.cpp ****     uint32_t phraseEndMs = lastActiveMs;
 339:ReactivePedal.cpp ****     if(phraseEndMs < phraseStartMs){
 340:ReactivePedal.cpp ****         phraseEndMs = phraseStartMs;
 341:ReactivePedal.cpp ****     }
 342:ReactivePedal.cpp **** 
 343:ReactivePedal.cpp ****     float phraseDurationSec = (float)(phraseEndMs - phraseStartMs) / 1000.0f;
 344:ReactivePedal.cpp ****     if(phraseDurationSec < 0.001f){
 345:ReactivePedal.cpp ****         phraseDurationSec = 0.001f;
 346:ReactivePedal.cpp ****     }
 347:ReactivePedal.cpp **** 
 348:ReactivePedal.cpp ****     float attacksPerSecond = (float)phraseAttackCount / phraseDurationSec;
 349:ReactivePedal.cpp **** 
 350:ReactivePedal.cpp ****     uint32_t gapFromLastAttackMs = 0;
 351:ReactivePedal.cpp ****     if(lastPhraseAttackMs > 0 && phraseEndMs >= lastPhraseAttackMs){
 352:ReactivePedal.cpp ****         gapFromLastAttackMs = phraseEndMs - lastPhraseAttackMs;
ARM GAS  /var/folders/6_/psd2b8g56p7696hhrr4ztjs00000gn/T//ccL16ted.s 			page 28


 353:ReactivePedal.cpp ****     }
 354:ReactivePedal.cpp ****     else{
 355:ReactivePedal.cpp ****         gapFromLastAttackMs = phraseEndMs - phraseStartMs;
 356:ReactivePedal.cpp ****     }
 357:ReactivePedal.cpp **** 
 358:ReactivePedal.cpp ****     float tailGapSec = (float)gapFromLastAttackMs / 1000.0f;
 359:ReactivePedal.cpp ****     //how much of phrase was 'tail' after last attack
 360:ReactivePedal.cpp ****     float sustainRatio = tailGapSec / phraseDurationSec;
 361:ReactivePedal.cpp **** 
 362:ReactivePedal.cpp ****     if(sustainRatio > 1.0f){
 363:ReactivePedal.cpp ****         sustainRatio = 1.0f;
 364:ReactivePedal.cpp ****     }
 365:ReactivePedal.cpp ****     out.onsetCount = (float)phraseAttackCount; //num of attacks 
 366:ReactivePedal.cpp ****     //repurposed to mean attacksPerSecond
 367:ReactivePedal.cpp ****     out.rmsDelta = attacksPerSecond;
 368:ReactivePedal.cpp ****     //repurpose to sustain detector
 369:ReactivePedal.cpp ****     out.envelopeDelta = sustainRatio;
 370:ReactivePedal.cpp ****     out.timeSinceLastOnset = tailGapSec; //tail duration
 371:ReactivePedal.cpp **** }
 372:ReactivePedal.cpp **** 
