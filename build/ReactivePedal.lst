 213:ReactivePedal.cpp **** //clamp function for safe audio clipping
 214:ReactivePedal.cpp **** float Clamp(float x, float lo, float hi){
 215:ReactivePedal.cpp ****     if(x < lo){
 216:ReactivePedal.cpp ****         return lo;
 217:ReactivePedal.cpp ****     }
 218:ReactivePedal.cpp ****     if(x > hi){
 219:ReactivePedal.cpp ****         return hi;
 220:ReactivePedal.cpp ****     }
 221:ReactivePedal.cpp ****     return x;
 222:ReactivePedal.cpp **** }
