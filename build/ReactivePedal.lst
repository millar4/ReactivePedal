 435:ReactivePedal.cpp **** float ComputeFeatureDistance(const AudioFeatures& a, const AudioFeatures& b){
 436:ReactivePedal.cpp ****     float d = 0.0f;
 437:ReactivePedal.cpp **** 
 438:ReactivePedal.cpp ****     float drms = (a.rms - b.rms) / 0.010f;
 439:ReactivePedal.cpp ****     float dpeak = (a.peak - b.peak) / 0.015f;
 440:ReactivePedal.cpp ****     float dflux = (a.spectralFlux - b.spectralFlux) / 0.050f;
 441:ReactivePedal.cpp ****     float drmsvar = (a.rmsVariance - b.rmsVariance) / 0.020f;
 442:ReactivePedal.cpp ****     float dcentvar = (a.centroidVariance - b.centroidVariance) / 500.0f;
 443:ReactivePedal.cpp ****     float donsets = (a.onsetCount - b.onsetCount) / 1.5f;
 444:ReactivePedal.cpp ****     float dattacksPerSec = (a.rmsDelta - b.rmsDelta) / 1.5f;
 445:ReactivePedal.cpp ****     float dsustainRatio = (a.envelopeDelta - b.envelopeDelta) / 0.25f;
 446:ReactivePedal.cpp ****     float dtailGap = (a.timeSinceLastOnset - b.timeSinceLastOnset) / 0.20f;
 447:ReactivePedal.cpp ****     float dcent = (a.spectralCentroid - b.spectralCentroid) / 800.0f;
 448:ReactivePedal.cpp ****     float dzcr = (a.zcr - b.zcr) / 0.12f;
 449:ReactivePedal.cpp **** 
 450:ReactivePedal.cpp ****     d += 0.6f * drms * drms;
 451:ReactivePedal.cpp ****     d += 0.5f * dpeak * dpeak;
 452:ReactivePedal.cpp ****     d += 0.7f * dflux * dflux;
 453:ReactivePedal.cpp ****     d += 0.8f * drmsvar * drmsvar;
 454:ReactivePedal.cpp ****     d += 0.7f * dcentvar * dcentvar;
 455:ReactivePedal.cpp ****     d += 3.2f * donsets * donsets;
 456:ReactivePedal.cpp ****     d += 2.8f * dattacksPerSec * dattacksPerSec;
 457:ReactivePedal.cpp ****     d += 4.0f * dsustainRatio * dsustainRatio;
 458:ReactivePedal.cpp ****     d += 2.2f * dtailGap * dtailGap;
 459:ReactivePedal.cpp ****     d += 0.4f * dcent * dcent;
 460:ReactivePedal.cpp ****     d += 0.3f * dzcr * dzcr;
 461:ReactivePedal.cpp **** 
 462:ReactivePedal.cpp ****     return sqrtf(d);
 463:ReactivePedal.cpp **** }
 464:ReactivePedal.cpp **** 
