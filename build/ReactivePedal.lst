 405:ReactivePedal.cpp ****         const AudioFeatures& f = featureBuffer[classId][i];
 406:ReactivePedal.cpp ****         out.rms += f.rms;
 407:ReactivePedal.cpp ****         out.peak += f.peak;
 408:ReactivePedal.cpp ****         out.zcr += f.zcr;
 409:ReactivePedal.cpp ****         out.spectralCentroid += f.spectralCentroid;
