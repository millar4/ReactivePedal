 423:ReactivePedal.cpp ****     out.zcr *= inv;
 424:ReactivePedal.cpp ****     out.spectralCentroid *= inv;
 425:ReactivePedal.cpp ****     out.spectralFlux *= inv;
 426:ReactivePedal.cpp ****     out.rmsDelta *= inv;
 427:ReactivePedal.cpp ****     out.envelope *= inv;
