 489:ReactivePedal.cpp ****     }
 490:ReactivePedal.cpp ****     else{
ARM GAS  /var/folders/6_/psd2b8g56p7696hhrr4ztjs00000gn/T//ccWUY8GP.s 			page 34


 491:ReactivePedal.cpp ****         gapFromLastAttackMs = phraseEndMs - phraseStartMs;
 492:ReactivePedal.cpp ****     }
 493:ReactivePedal.cpp **** 
 494:ReactivePedal.cpp ****     float tailGapSec = (float)gapFromLastAttackMs / 1000.0f;
