 826:ReactivePedal.cpp ****         phraseFeatures.timeSinceLastOnset < 0.04f;
 827:ReactivePedal.cpp **** 
 828:ReactivePedal.cpp ****     return pureTail || freshTransientOnly;
 829:ReactivePedal.cpp **** }
