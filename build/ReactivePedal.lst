 249:ReactivePedal.cpp **** 
 250:ReactivePedal.cpp ****     phraseMaxRms = 0.0f;
 251:ReactivePedal.cpp ****     phraseMinRms = 1.0f;
 252:ReactivePedal.cpp ****     phraseMaxCentroid = 0.0f;
 253:ReactivePedal.cpp ****     phraseMinCentroid = 1000000.0f;
 254:ReactivePedal.cpp ****     phraseMaxPeak = 0.0f;
 255:ReactivePedal.cpp ****     phraseAttackCount = 0;
 256:ReactivePedal.cpp ****     lastPhraseAttackMs = 0;
 257:ReactivePedal.cpp ****     firstPhraseAttackMs = 0;
 258:ReactivePedal.cpp ****     prevPhraseAttackMs = 0;
