 464:ReactivePedal.cpp ****     out.zcr = phraseAccum.zcr * inv;
 465:ReactivePedal.cpp ****     out.spectralCentroid = phraseAccum.spectralCentroid * inv;
 466:ReactivePedal.cpp ****     out.spectralFlux = phraseAccum.spectralFlux * inv;
 467:ReactivePedal.cpp ****     out.envelope = phraseAccum.envelope * inv;
 468:ReactivePedal.cpp ****     out.rmsVariance = phraseMaxRms - phraseMinRms;
 469:ReactivePedal.cpp ****     out.centroidVariance = phraseMaxCentroid - phraseMinCentroid;
 470:ReactivePedal.cpp **** 
