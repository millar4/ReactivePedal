 141:screen.cpp    **** }
 142:screen.cpp    **** 
 143:screen.cpp    **** static void DrawChar(int x, int y, char c, uint16_t colour, uint16_t bg, int scale)
 144:screen.cpp    **** {
 145:screen.cpp    ****     if(c < 32 || c > 127){
 146:screen.cpp    ****         c = '?';
 147:screen.cpp    ****     }
 148:screen.cpp    **** 
 149:screen.cpp    ****     const uint8_t* bitmap = font5x7[c - 32];
 150:screen.cpp    **** 
 151:screen.cpp    ****     for(int col = 0; col < 5; col++){
 152:screen.cpp    ****         uint8_t line = bitmap[col];
 153:screen.cpp    **** 
 154:screen.cpp    ****         for(int row = 0; row < 7; row++){
 155:screen.cpp    ****             uint16_t pixelColour = (line & (1 << row)) ? colour : bg;
 156:screen.cpp    **** 
 157:screen.cpp    ****             if(scale <= 1){
 158:screen.cpp    ****                 DrawPixel(x + col, y + row, pixelColour);
 159:screen.cpp    ****             }
 160:screen.cpp    ****             else{
 161:screen.cpp    ****                 FillRect(x + col * scale, y + row * scale, scale, scale, pixelColour);
 162:screen.cpp    ****             }
 163:screen.cpp    ****         }
 164:screen.cpp    ****     }
