 471:MiniCABClassifier.cpp **** float MiniCABClassifier::EventAttentionLogit(const float input[inputSize]) const{
 472:MiniCABClassifier.cpp ****     float level = 0.35f * fabsf(input[0]) + 0.25f * fabsf(input[1]) + 0.25f * fabsf(input[6]);
 473:MiniCABClassifier.cpp ****     float movement = 0.70f * fabsf(input[4]) + 0.35f * fabsf(input[5]) + 0.35f * fabsf(input[7]) + 
 474:MiniCABClassifier.cpp ****     float logit = -1.0f + level + movement;
 475:MiniCABClassifier.cpp **** 
 476:MiniCABClassifier.cpp ****     return ClipValue(logit, -8.0f, 8.0f);
 477:MiniCABClassifier.cpp **** }
 478:MiniCABClassifier.cpp **** 
 479:MiniCABClassifier.cpp **** float MiniCABClassifier::GapAttentionLogit(const float input[inputSize]) const{
 480:MiniCABClassifier.cpp ****     float quietness = -0.25f * fabsf(input[0]) - 0.20f * fabsf(input[1]) - 0.15f * fabsf(input[4]);
 481:MiniCABClassifier.cpp ****     float logit = 0.85f * input[11] + quietness;
 482:MiniCABClassifier.cpp **** 
 483:MiniCABClassifier.cpp ****     return ClipValue(logit, -8.0f, 8.0f);
 484:MiniCABClassifier.cpp **** }
