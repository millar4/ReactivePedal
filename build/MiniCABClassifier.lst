  88:MiniCABClassifier.cpp **** CABOutput MiniCABClassifier::PredictSequence() const{
  89:MiniCABClassifier.cpp ****     CABOutput out = {};
  90:MiniCABClassifier.cpp **** 
  91:MiniCABClassifier.cpp ****     if(frameCount == 0){
  92:MiniCABClassifier.cpp ****         return out;
  93:MiniCABClassifier.cpp ****     }
  94:MiniCABClassifier.cpp **** 
  95:MiniCABClassifier.cpp ****     float seq[timeSteps][inputSize];
ARM GAS  /var/folders/6_/psd2b8g56p7696hhrr4ztjs00000gn/T//ccoBC1xF.s 			page 13


  96:MiniCABClassifier.cpp ****     float convPre[numConvFilters][convTimeSteps];
  97:MiniCABClassifier.cpp ****     float convAct[numConvFilters][convTimeSteps];
  98:MiniCABClassifier.cpp ****     float rep[representationSize];
  99:MiniCABClassifier.cpp ****     int maxIndex[numConvFilters];
 100:MiniCABClassifier.cpp **** 
 101:MiniCABClassifier.cpp ****     BuildSequenceFromBuffer(seq);
 102:MiniCABClassifier.cpp ****     CNNForward(seq, convPre, convAct, rep, maxIndex);
 103:MiniCABClassifier.cpp **** 
 104:MiniCABClassifier.cpp ****     float alpha[numClassifiers];
 105:MiniCABClassifier.cpp ****     AttentionUnitPredict(rep, alpha);
 106:MiniCABClassifier.cpp **** 
 107:MiniCABClassifier.cpp ****     float finalScores[numClasses] = {0.0f};
 108:MiniCABClassifier.cpp **** 
 109:MiniCABClassifier.cpp ****     for(int cl = 0; cl < numClassifiers; cl++){
 110:MiniCABClassifier.cpp ****         float probs[numClasses];
 111:MiniCABClassifier.cpp ****         ClassifierPredict(cl, rep, probs);
 112:MiniCABClassifier.cpp **** 
 113:MiniCABClassifier.cpp ****         for(int k = 0; k < numClasses; k++){
 114:MiniCABClassifier.cpp ****             finalScores[k] += alpha[cl] * probs[k];
 115:MiniCABClassifier.cpp ****         }
 116:MiniCABClassifier.cpp ****     }
 117:MiniCABClassifier.cpp **** 
 118:MiniCABClassifier.cpp ****     int bestClass = 0;
 119:MiniCABClassifier.cpp ****     float bestScore = finalScores[0];
 120:MiniCABClassifier.cpp **** 
 121:MiniCABClassifier.cpp ****     for(int i = 1; i < numClasses; i++){
 122:MiniCABClassifier.cpp ****         if(finalScores[i] > bestScore){
 123:MiniCABClassifier.cpp ****             bestScore = finalScores[i];
 124:MiniCABClassifier.cpp ****             bestClass = i;
 125:MiniCABClassifier.cpp ****         }
 126:MiniCABClassifier.cpp ****     }
 127:MiniCABClassifier.cpp **** 
 128:MiniCABClassifier.cpp ****     for(int i = 0; i < numClasses; i++){
 129:MiniCABClassifier.cpp ****         out.scores[i] = finalScores[i];
 130:MiniCABClassifier.cpp ****     }
 131:MiniCABClassifier.cpp **** 
 132:MiniCABClassifier.cpp ****     out.predictedClass = bestClass;
 133:MiniCABClassifier.cpp ****     return out;
 134:MiniCABClassifier.cpp **** }
