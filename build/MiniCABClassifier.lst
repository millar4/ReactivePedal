 312:MiniCABClassifier.cpp **** void MiniCABClassifier::ClassifierPredict(int classifierId, const float rep[representationSize], fl
 313:MiniCABClassifier.cpp ****     float hidden[classifierHiddenSize];
 314:MiniCABClassifier.cpp **** 
 315:MiniCABClassifier.cpp ****     for(int i = 0; i < classifierHiddenSize; i++){
 316:MiniCABClassifier.cpp ****         float sum = classifierB1[classifierId][i];
 317:MiniCABClassifier.cpp **** 
 318:MiniCABClassifier.cpp ****         for(int j = 0; j < representationSize; j++){
 319:MiniCABClassifier.cpp ****             sum += classifierW1[classifierId][i][j] * rep[j];
 320:MiniCABClassifier.cpp ****         }
 321:MiniCABClassifier.cpp **** 
 322:MiniCABClassifier.cpp ****         hidden[i] = ReLU(sum);
 323:MiniCABClassifier.cpp ****     }
 324:MiniCABClassifier.cpp **** 
 325:MiniCABClassifier.cpp ****     for(int i = 0; i < numClasses; i++){
 326:MiniCABClassifier.cpp ****         float sum = classifierB2[classifierId][i];
 327:MiniCABClassifier.cpp **** 
 328:MiniCABClassifier.cpp ****         for(int j = 0; j < classifierHiddenSize; j++){
 329:MiniCABClassifier.cpp ****             sum += classifierW2[classifierId][i][j] * hidden[j];
 330:MiniCABClassifier.cpp ****         }
 331:MiniCABClassifier.cpp **** 
 332:MiniCABClassifier.cpp ****         probs[i] = sum;
