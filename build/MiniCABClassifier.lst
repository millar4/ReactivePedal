 423:MiniCABClassifier.cpp **** float MiniCABClassifier::ConvFilterValue(const float seq[timeSteps][inputSize], int filterId, int t
 424:MiniCABClassifier.cpp ****     float sum = 0.0f;
 425:MiniCABClassifier.cpp **** 
 426:MiniCABClassifier.cpp ****     for(int r = 0; r < convKernelSize; r++){
 427:MiniCABClassifier.cpp ****         int idx = t + r;
 428:MiniCABClassifier.cpp **** 
 429:MiniCABClassifier.cpp ****         switch(filterId){
 430:MiniCABClassifier.cpp ****             case 0:
 431:MiniCABClassifier.cpp ****                 sum += seq[idx][0];
 432:MiniCABClassifier.cpp ****                 break;
 433:MiniCABClassifier.cpp ****             case 1:
 434:MiniCABClassifier.cpp ****                 sum += seq[idx][1];
 435:MiniCABClassifier.cpp ****                 break;
 436:MiniCABClassifier.cpp ****             case 2:
 437:MiniCABClassifier.cpp ****                 sum += seq[idx][4];
 438:MiniCABClassifier.cpp ****                 break;
ARM GAS  /var/folders/6_/psd2b8g56p7696hhrr4ztjs00000gn/T//ccrN3Asy.s 			page 25


 439:MiniCABClassifier.cpp ****             case 3:
 440:MiniCABClassifier.cpp ****                 sum += seq[idx][6];
 441:MiniCABClassifier.cpp ****                 break;
 442:MiniCABClassifier.cpp ****             case 4:
 443:MiniCABClassifier.cpp ****                 sum += 0.60f * seq[idx][10] + 0.40f * seq[idx][5];
 444:MiniCABClassifier.cpp ****                 break;
 445:MiniCABClassifier.cpp ****             case 5:
 446:MiniCABClassifier.cpp ****                 sum += seq[idx][11];
 447:MiniCABClassifier.cpp ****                 break;
 448:MiniCABClassifier.cpp ****             case 6:
 449:MiniCABClassifier.cpp ****                 sum += seq[idx][3];
 450:MiniCABClassifier.cpp ****                 break;
 451:MiniCABClassifier.cpp ****             case 7:
 452:MiniCABClassifier.cpp ****                 if(r == convKernelSize - 1){
 453:MiniCABClassifier.cpp ****                     sum += seq[idx][6] + 0.50f * seq[idx][4] + 0.30f * seq[idx][1];
 454:MiniCABClassifier.cpp ****                 }
 455:MiniCABClassifier.cpp ****                 else if(r == 0){
 456:MiniCABClassifier.cpp ****                     sum -= seq[idx][6] + 0.50f * seq[idx][4] + 0.30f * seq[idx][1];
 457:MiniCABClassifier.cpp ****                 }
 458:MiniCABClassifier.cpp ****                 break;
 459:MiniCABClassifier.cpp ****             default:
 460:MiniCABClassifier.cpp ****                 break;
 461:MiniCABClassifier.cpp ****         }
 462:MiniCABClassifier.cpp ****     }
 463:MiniCABClassifier.cpp **** 
 464:MiniCABClassifier.cpp ****     if(filterId != 7){
 465:MiniCABClassifier.cpp ****         sum /= (float)convKernelSize;
 466:MiniCABClassifier.cpp ****     }
 467:MiniCABClassifier.cpp **** 
 468:MiniCABClassifier.cpp ****     return sum;
 469:MiniCABClassifier.cpp **** }
